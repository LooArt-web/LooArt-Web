# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.

NODE_ENV=development
PUERTO=3000

# Base de datos MySQL 8 (esquema looart1)
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=looart_app
DB_CLAVE=
DB_NOMBRE=looart1
# true para TiDB Cloud o cualquier BD fuera de esta máquina: TLS 1.2+ verificando el certificado
DB_TLS=false

# Orígenes del front que pueden llamar a la API, separados por coma. Nunca "*".
ORIGENES_PERMITIDOS=https://looart-web.pages.dev,http://localhost:5500

# Secreto compartido con el proxy de Cloudflare Pages (fase 2+). Mínimo 32 caracteres.
SECRETO_ORIGEN=

# Almacenamiento de archivos: "disco" (desarrollo y pruebas) o "r2" (producción)
ALMACEN=disco
R2_CUENTA=
R2_LLAVE=
R2_SECRETO=
R2_BUCKET=
R2_URL_PUBLICA=

# Número de WhatsApp del negocio: solo dígitos, con lada de país y sin "+" (12 o 13 dígitos).
# Obligatorio. El número real se escribe solo en el .env del servidor.
WHATSAPP_NEGOCIO=

# Origen público del sitio, para el enlace "Ver cotización" del mensaje de WhatsApp
URL_SITIO=https://looart-web.pages.dev

# Sesión del panel (fase 5)
SESION_HORAS=8
BLOQUEO_MINUTOS=15
